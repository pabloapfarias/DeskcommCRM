# Imagem pequena e estável para desenvolvimento com hot reload.
#
# O código e o node_modules entram por bind mount no
# docker-compose.dev.yml. Esta imagem só fornece Node e as ferramentas de
# sistema que também existem na imagem de produção.
FROM node:22-alpine

RUN apk add --no-cache ffmpeg

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1
